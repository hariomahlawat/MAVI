info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@artifactId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT a.id, a.artifact_type, a.storage_key, a.mime_type, a.size_bytes, a.sha256
      FROM artifacts AS a
      WHERE a.id = @artifactId AND ((a.artifact_type IN ('Thumbnail', 'EvidenceCrop') AND EXISTS (
          SELECT 1
          FROM observations AS o
          WHERE o.thumbnail_artifact_id = a.id AND EXISTS (
              SELECT 1
              FROM tracks AS t
              WHERE t.id = o.track_id AND EXISTS (
                  SELECT 1
                  FROM processing_runs AS p
                  WHERE p.id = t.processing_run_id AND p.status = 'Completed' AND p.completed_at_utc IS NOT NULL)))) OR (a.artifact_type = 'TrackTrajectory' AND EXISTS (
          SELECT 1
          FROM tracks AS t0
          WHERE t0.trajectory_artifact_id = a.id AND EXISTS (
              SELECT 1
              FROM processing_runs AS p0
              WHERE p0.id = t0.processing_run_id AND p0.status = 'Completed' AND p0.completed_at_utc IS NOT NULL))))
      LIMIT 2
