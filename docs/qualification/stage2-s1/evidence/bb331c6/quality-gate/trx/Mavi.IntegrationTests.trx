          FROM trip_lines AS t
          WHERE s0.id = t.revision_id AND t.enabled)) AND p.completed_at_utc &gt;= s0.created_at_utc AND NOT EXISTS (
          SELECT 1
          FROM scene_analyses AS s2
          WHERE s2.processing_run_id = p.id AND s2.revision_id = s0.id AND (s2.algorithm_version = @algorithmVersion OR s2.status = 'Completed' OR s2.status = 'Superseded'))
      ORDER BY p.completed_at_utc, p.id
      LIMIT @p
