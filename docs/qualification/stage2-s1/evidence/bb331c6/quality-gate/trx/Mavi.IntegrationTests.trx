      SELECT t.id, t.processing_run_id, t.video_asset_id, c.id, c.code, c.name, t.object_class, t.start_timestamp_utc, t.end_timestamp_utc, t.start_offset_ms, t.end_offset_ms, t.duration_ms, t.detection_count, t.mean_confidence, t.max_confidence, t.review_status, o.thumbnail_artifact_id
