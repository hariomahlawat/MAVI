          SELECT 1
          FROM observations AS o
          WHERE o.thumbnail_artifact_id = a.id AND EXISTS (
              SELECT 1
              FROM tracks AS t
              WHERE t.id = o.track_id AND EXISTS (
                  SELECT 1
