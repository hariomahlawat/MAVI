      SELECT p.id, s0.id
      FROM processing_runs AS p
      INNER JOIN video_assets AS v ON p.video_asset_id = v.id
      INNER JOIN scene_configurations AS s ON v.camera_id = s.camera_id
      INNER JOIN scene_configuration_revisions AS s0 ON s.active_revision_id = s0.id
      WHERE p.status = 'Completed' AND p.visibility_sequence IS NOT NULL AND p.completed_at_utc IS NOT NULL AND p.completed_at_utc &gt;= @earliestRunCompletedAtUtc AND (EXISTS (
          SELECT 1
          FROM scene_zones AS s1
          WHERE s0.id = s1.revision_id AND s1.enabled) OR EXISTS (
