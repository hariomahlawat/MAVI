      SELECT * FROM scene_analyses
      WHERE status = 'Running'
        AND attempt_count &gt;= @p0
        AND lease_expires_at_utc IS NOT NULL
        AND lease_expires_at_utc &lt; @p1
      ORDER BY id
      FOR UPDATE SKIP LOCKED
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[p0='?' (DbType = Int32), p1='?', p2='?', p3='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      SELECT m.id, m.algorithm_version, m.analysed_track_count, m.attempt_count, m.claim_token_hash, m.completed_at_utc, m.failure_code, m.failure_details, m.lease_expires_at_utc, m.parameters_sha256, m.processing_run_id, m.queued_at_utc, m.revision_id, m.source_commit, m.started_at_utc, m.status, m.unavailable_track_count, m.visibility_sequence
      FROM (
          SELECT * FROM scene_analyses
          WHERE attempt_count &lt; @p0
            -- The engine fence, in the predicate rather than after the fact: a host
            -- must not take ownership of a unit it cannot execute, because taking it
            -- consumes an attempt and hides the unit from the host that could.
            AND algorithm_version = @p1
            AND parameters_sha256 = @p2
            AND (status = 'Queued'
                 OR (status = 'Running'
                     AND lease_expires_at_utc IS NOT NULL
                     AND lease_expires_at_utc &lt; @p3))
          ORDER BY queued_at_utc, id
          FOR UPDATE SKIP LOCKED LIMIT 1
      ) AS m
      LIMIT 2
