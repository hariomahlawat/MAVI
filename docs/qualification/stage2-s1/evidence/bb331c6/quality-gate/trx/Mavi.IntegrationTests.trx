      SELECT t.id, t.processing_run_id, t.video_asset_id, c.id, c.code, c.name, t.object_class, t.local_track_number, t.start_offset_ms, t.end_offset_ms, t.start_timestamp_utc, t.end_timestamp_utc, t.duration_ms, t.detection_count, t.mean_confidence, t.max_confidence, t.review_status, p.pipeline_version, p.detector_name, p.detector_version, p.tracker_name, p.tracker_version, p.completed_at_utc, v.recording_start_utc, v.recording_end_utc, v.duration_ms, v.width, v.height, v.frame_rate_numerator, v.frame_rate_denominator, t.representative_observation_id, t.trajectory_artifact_id
      FROM tracks AS t
      INNER JOIN processing_runs AS p ON t.processing_run_id = p.id
      INNER JOIN video_assets AS v ON t.video_asset_id = v.id
