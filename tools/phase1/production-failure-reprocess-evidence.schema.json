{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/schemas/production-failure-reprocess-evidence-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "acceptanceExecutionId",
    "acceptanceContextSha256",
    "scenarioStartedAtUtc",
    "scenarioCompletedAtUtc",
    "sourceCommit",
    "maviBuild",
    "operationalHostIdentitySha256",
    "targetVerifiedManifestSha256",
    "deploymentProfile",
    "deploymentProfilePolicySha256",
    "runtimeVariant",
    "productionBundleManifestSha256",
    "productionReleaseLockSha256",
    "variantEvidenceSha256",
    "workerPythonSha256",
    "workerEnvironmentSha256",
    "workerVenvRootSha256",
    "workerResolvedPythonSha256",
    "videoAssetId",
    "firstProcessingRunId",
    "firstVisionJobId",
    "failureCode",
    "reprocessProcessingRunId",
    "reprocessAttestation",
    "sourceMedia",
    "trackCount",
    "workerLogSha256",
    "networkIsolation",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": "mavi-production-failure-reprocess-evidence-v2" },
    "acceptanceExecutionId": { "type": "string", "format": "uuid" },
    "acceptanceContextSha256": { "$ref": "#/$defs/sha256" },
    "scenarioStartedAtUtc": { "type": "string", "format": "date-time" },
    "scenarioCompletedAtUtc": { "type": "string", "format": "date-time" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "maviBuild": { "type": "string", "minLength": 1 },
    "operationalHostIdentitySha256": { "$ref": "#/$defs/sha256" },
    "targetVerifiedManifestSha256": { "$ref": "#/$defs/sha256" },
    "deploymentProfile": { "enum": ["P1","P2","P3"] },
    "deploymentProfilePolicySha256": { "$ref": "#/$defs/sha256" },
    "runtimeVariant": {
      "enum": [
        "windows-x86_64-cpu",
        "windows-x86_64-cuda",
        "linux-x86_64-cpu",
        "linux-x86_64-cuda"
      ]
    },
    "productionBundleManifestSha256": { "$ref": "#/$defs/sha256" },
    "productionReleaseLockSha256": { "$ref": "#/$defs/sha256" },
    "variantEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "workerPythonSha256": { "$ref": "#/$defs/sha256" },
    "workerEnvironmentSha256": { "$ref": "#/$defs/sha256" },
    "workerVenvRootSha256": { "$ref": "#/$defs/sha256" },
    "workerResolvedPythonSha256": { "$ref": "#/$defs/sha256" },
    "videoAssetId": { "$ref": "#/$defs/guid" },
    "firstProcessingRunId": { "$ref": "#/$defs/guid" },
    "firstVisionJobId": { "$ref": "#/$defs/guid" },
    "failureCode": { "const": "task17_controlled_failure" },
    "reprocessProcessingRunId": { "$ref": "#/$defs/guid" },
    "reprocessAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationStatus",
        "runtimeVariant",
        "actualDevice",
        "maviBuild",
        "maviCommit",
        "modelManifestSha256",
        "platformLockSha256"
      ],
      "properties": {
        "verificationStatus": { "const": "verified" },
        "runtimeVariant": {
          "enum": [
            "windows-x86_64-cpu",
            "windows-x86_64-cuda",
            "linux-x86_64-cpu",
            "linux-x86_64-cuda"
          ]
        },
        "actualDevice": { "type": "string", "minLength": 1 },
        "maviBuild": { "type": "string", "minLength": 1 },
        "maviCommit": { "type": "string", "minLength": 1 },
        "modelManifestSha256": { "$ref": "#/$defs/sha256" },
        "platformLockSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localSha256",
        "afterFailureSha256",
        "afterFailureEtagSha256",
        "afterReprocessSha256",
        "afterReprocessEtagSha256"
      ],
      "properties": {
        "localSha256": { "$ref": "#/$defs/sha256" },
        "afterFailureSha256": { "$ref": "#/$defs/sha256" },
        "afterFailureEtagSha256": { "$ref": "#/$defs/sha256" },
        "afterReprocessSha256": { "$ref": "#/$defs/sha256" },
        "afterReprocessEtagSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "trackCount": { "type": "integer", "minimum": 1 },
    "workerLogSha256": { "$ref": "#/$defs/sha256" },
    "networkIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxyEnvironmentAbsent","probes","passed"],
      "properties": {
        "proxyEnvironmentAbsent": { "const": true },
        "probes": { "type": "array", "minItems": 5 },
        "passed": { "const": true }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed","failureCodes"],
      "properties": {
        "passed": { "const": true },
        "failureCodes": { "type": "array", "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "guid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
  }
}
