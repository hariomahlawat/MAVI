{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/schemas/production-log-inspection-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion","sourceCommit","maviBuild","formalE2eSha256",
    "emptySceneDiagnosticSha256","failureReprocessSha256","allowedHosts",
    "logs","result"
  ],
  "properties": {
    "schemaVersion": { "const": "mavi-production-log-inspection-evidence-v1" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "maviBuild": { "type": "string", "minLength": 1 },
    "formalE2eSha256": { "$ref": "#/$defs/sha256" },
    "emptySceneDiagnosticSha256": { "$ref": "#/$defs/sha256" },
    "failureReprocessSha256": { "$ref": "#/$defs/sha256" },
    "allowedHosts": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path","sizeBytes","sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed","externalUrlHits","telemetryOrLicenceHits","failureCodes"],
      "properties": {
        "passed": { "const": true },
        "externalUrlHits": { "type": "array", "maxItems": 0 },
        "telemetryOrLicenceHits": { "type": "array", "maxItems": 0 },
        "failureCodes": { "type": "array", "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
