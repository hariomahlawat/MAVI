{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/schemas/application-lifecycle-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "mode", "sourceCommit", "build", "applicationManifestSha256",
    "supportedUpdatesPolicySha256", "destination", "hosting", "internetUnavailable", "networkIsolation", "priorRelease", "migrationPolicy",
    "retainedState", "uiSmoke", "observedHealth", "result"
  ],
  "properties": {
    "schemaVersion": { "const": "mavi-application-lifecycle-evidence-v1" },
    "mode": { "enum": ["fresh-install", "offline-update"] },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "build": { "type": "string", "minLength": 1 },
    "applicationManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "supportedUpdatesPolicySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "destination": { "type": "string", "minLength": 1 },
    "hosting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteName", "applicationPool", "physicalPath", "hostIdentitySha256", "passed"],
      "properties": {
        "siteName": { "type": "string", "minLength": 1 },
        "applicationPool": { "type": "string", "minLength": 1 },
        "physicalPath": { "type": "string", "minLength": 1 },
        "hostIdentitySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "passed": { "const": true }
      }
    },
    "internetUnavailable": { "const": true },
    "networkIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxyEnvironmentAbsent", "probes", "passed"],
      "properties": {
        "proxyEnvironmentAbsent": { "const": true },
        "probes": { "type": "array", "minItems": 5 },
        "passed": { "const": true }
      }
    },
    "priorRelease": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sourceCommit", "build", "applicationManifestSha256", "supported"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "build": { "type": "string", "minLength": 1 },
        "applicationManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "supported": { "const": true }
      }
    },
    "migrationPolicy": { "enum": ["none", "required"] },
    "retainedState": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["acceptanceEvidenceSha256", "preUpdateCheckSha256", "postUpdateCheckSha256"],
      "properties": {
        "acceptanceEvidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "preUpdateCheckSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "postUpdateCheckSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "uiSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootStatusCode", "rootBytes", "assetCount", "passed"],
      "properties": {
        "rootStatusCode": { "const": 200 },
        "rootBytes": { "type": "integer", "minimum": 1 },
        "assetCount": { "type": "integer", "minimum": 1 },
        "passed": { "const": true }
      }
    },
    "migration": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["commandIdentity", "exitCode", "passed"],
      "properties": {
        "commandIdentity": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer" },
        "passed": { "type": "boolean" }
      }
    },
    "observedHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "build", "commit"],
      "properties": {
        "status": { "const": "ok" },
        "build": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failureCodes"],
      "properties": {
        "passed": { "type": "boolean" },
        "failureCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
