{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/schemas/cctv-quality-corpus-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion","sourceCommit","maviBuild","targetVerifiedManifestSha256",
    "acceptanceProfileSha256","corpusManifestSha256","cases","aggregate","result"
  ],
  "properties": {
    "schemaVersion": { "const": "mavi-cctv-quality-corpus-evidence-v1" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "maviBuild": { "type": "string", "minLength": 1 },
    "targetVerifiedManifestSha256": { "$ref": "#/$defs/sha256" },
    "acceptanceProfileSha256": { "$ref": "#/$defs/sha256" },
    "corpusManifestSha256": { "$ref": "#/$defs/sha256" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId","mediaSha256","groundTruthManifestSha256",
          "acceptanceEvidenceSha256","videoAssetId","processingRunId","metrics"
        ],
        "properties": {
          "caseId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "mediaSha256": { "$ref": "#/$defs/sha256" },
          "groundTruthManifestSha256": { "$ref": "#/$defs/sha256" },
          "acceptanceEvidenceSha256": { "$ref": "#/$defs/sha256" },
          "videoAssetId": { "$ref": "#/$defs/guid" },
          "processingRunId": { "$ref": "#/$defs/guid" },
          "metrics": { "type": "object" }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perClass","overall","qualification"],
      "properties": {
        "perClass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Person","Vehicle"],
          "properties": {
            "Person": { "$ref": "#/$defs/summary" },
            "Vehicle": { "$ref": "#/$defs/summary" }
          }
        },
        "overall": { "$ref": "#/$defs/summary" },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed","failures"],
          "properties": {
            "passed": { "type": "boolean" },
            "failures": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed","failureCodes"],
      "properties": {
        "passed": { "type": "boolean" },
        "failureCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "guid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "metric": { "type": ["number","null"], "minimum": 0, "maximum": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groundTruthEventCount","producedTrackCount","matchedCount",
        "missedCount","unmatchedTrackCount","precision","recall","f1"
      ],
      "properties": {
        "groundTruthEventCount": { "type": "integer", "minimum": 0 },
        "producedTrackCount": { "type": "integer", "minimum": 0 },
        "matchedCount": { "type": "integer", "minimum": 0 },
        "missedCount": { "type": "integer", "minimum": 0 },
        "unmatchedTrackCount": { "type": "integer", "minimum": 0 },
        "precision": { "$ref": "#/$defs/metric" },
        "recall": { "$ref": "#/$defs/metric" },
        "f1": { "$ref": "#/$defs/metric" }
      }
    }
  }
}
