{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/schemas/production-acceptance-context-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","acceptanceExecutionId","sourceCommit","maviBuild","startedAtUtc"],
  "properties": {
    "schemaVersion": { "const": "mavi-production-acceptance-context-v1" },
    "acceptanceExecutionId": { "type": "string", "format": "uuid" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "maviBuild": { "type": "string", "minLength": 1 },
    "startedAtUtc": { "type": "string", "format": "date-time" }
  }
}
