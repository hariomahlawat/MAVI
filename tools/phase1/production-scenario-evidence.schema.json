{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/schemas/production-scenario-evidence-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "acceptanceExecutionId",
    "acceptanceContextSha256",
    "scenarioStartedAtUtc",
    "scenarioCompletedAtUtc",
    "mode",
    "sourceCommit",
    "maviBuild",
    "operationalHostIdentitySha256",
    "targetVerifiedManifestSha256",
    "deploymentProfile",
    "deploymentProfilePolicySha256",
    "runtimeVariant",
    "variantEvidenceSha256",
    "productionBundleManifestSha256",
    "productionReleaseLockSha256",
    "workerPythonSha256",
    "workerEnvironmentSha256",
    "workerVenvRootSha256",
    "workerResolvedPythonSha256",
    "e2eEvidenceSha256",
    "workerLogSha256",
    "networkIsolation",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": "mavi-production-scenario-evidence-v2" },
    "acceptanceExecutionId": { "type": "string", "format": "uuid" },
    "acceptanceContextSha256": { "$ref": "#/$defs/sha256" },
    "scenarioStartedAtUtc": { "type": "string", "format": "date-time" },
    "scenarioCompletedAtUtc": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["formal","empty-scene-diagnostic"] },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "maviBuild": { "type": "string", "minLength": 1 },
    "operationalHostIdentitySha256": { "$ref": "#/$defs/sha256" },
    "targetVerifiedManifestSha256": { "$ref": "#/$defs/sha256" },
    "deploymentProfile": { "enum": ["P1","P2","P3"] },
    "deploymentProfilePolicySha256": { "$ref": "#/$defs/sha256" },
    "runtimeVariant": {
      "enum": [
        "windows-x86_64-cpu",
        "windows-x86_64-cuda",
        "linux-x86_64-cpu",
        "linux-x86_64-cuda"
      ]
    },
    "variantEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "productionBundleManifestSha256": { "$ref": "#/$defs/sha256" },
    "productionReleaseLockSha256": { "$ref": "#/$defs/sha256" },
    "workerPythonSha256": { "$ref": "#/$defs/sha256" },
    "workerEnvironmentSha256": { "$ref": "#/$defs/sha256" },
    "workerVenvRootSha256": { "$ref": "#/$defs/sha256" },
    "workerResolvedPythonSha256": { "$ref": "#/$defs/sha256" },
    "e2eEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "workerLogSha256": { "$ref": "#/$defs/sha256" },
    "networkIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxyEnvironmentAbsent","probes","passed"],
      "properties": {
        "proxyEnvironmentAbsent": { "const": true },
        "probes": { "type": "array", "minItems": 5 },
        "passed": { "const": true }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed","failureCodes"],
      "properties": {
        "passed": { "const": true },
        "failureCodes": { "type": "array", "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
