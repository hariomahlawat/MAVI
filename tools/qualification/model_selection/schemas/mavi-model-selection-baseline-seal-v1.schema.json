        },
        "stage1RuleSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "status": {
          "const": "STOPPED"
        },
        "stopDetail": {
          "minLength": 1,
          "type": "string"
        },
        "stopEvidenceSha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "stopReason": {
          "enum": [
            "no-partner-passed-layer-a",
            "partner-event-missing",
            "partner-event-inconsistent",
            "partner-universe-inconsistent",
            "identity-mismatch",
            "resolution-ambiguous",
            "protected-d-accessed",
            "prerequisite-failed"
          ]
        }
      },
      "required": [
        "benchmarkBaselineId",
        "benchmarkComponentIdentitySha256",
        "capabilityId",
        "compositionId",
        "eligibleUniverseSha256",
        "eventId",
        "frozenLedgerSha256",
        "gateScope",
        "layerAGatesSha256",
        "layerAResultSha256",
        "partnerEventId",
        "partnerFrozenLedgerSha256",
        "partnerRankingRuleSha256",
        "protectedDAccessedAt",
        "protectedDState",
        "protocolSha256",
        "recordedAt",
        "recordedBy",
        "schema",
        "stage1RuleSha256",
        "status",
        "stopDetail",
        "stopEvidenceSha256s",
        "stopReason"
      ],
      "type": "object"
    }
  ]
