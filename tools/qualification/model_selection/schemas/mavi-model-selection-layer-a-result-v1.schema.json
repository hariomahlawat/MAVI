{
  "$id": "urn:mavi:mavi-model-selection-layer-a-result-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Shape contract (MSR revision M3). Reconciliation with the frozen Stage-1 rule and the derivation (lowest rank key among partners passing every gate; a tie is ambiguous) are checked by model_selection/baseline_seal.py.",
  "properties": {
    "compositionId": {
      "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
      "type": "string"
    },
    "eventId": {
      "pattern": "^msr-[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?-\\d{4}-\\d{2}$",
      "type": "string"
    },
    "evidenceSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "layerAGateIds": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "layerAGatesSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "partnerEventId": {
      "pattern": "^msr-[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?-\\d{4}-\\d{2}$",
      "type": "string"
    },
    "partnerFrozenLedgerSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "partnerRankingRuleSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
            "type": "string"
          },
          "gates": {
            "additionalProperties": {
              "enum": [
                "passed",
                "failed"
              ]
            },
            "minProperties": 1,
            "type": "object"
          },
          "identitySha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "measurementSha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "rankKey": {
            "items": {
              "type": [
                "boolean",
                "number",
                "string"
              ]
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "candidateId",
          "gates",
          "identitySha256",
          "measurementSha256",
          "rankKey"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "mavi-model-selection-layer-a-result-v1"
    }
  },
  "required": [
    "compositionId",
    "eventId",
    "evidenceSha256",
    "layerAGateIds",
    "layerAGatesSha256",
    "partnerEventId",
    "partnerFrozenLedgerSha256",
    "partnerRankingRuleSha256",
    "results",
    "schema"
  ],
  "type": "object"
}
