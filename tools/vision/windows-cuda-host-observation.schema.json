{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/schemas/windows-cuda-host-observation-v1.json",
  "title": "MAVI Windows CUDA Host Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "host",
    "nvidia",
    "qualification"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mavi-windows-cuda-host-observation-v1"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "release", "version", "machine"],
      "properties": {
        "system": { "const": "Windows" },
        "release": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "machine": {
          "type": "string",
          "pattern": "^(?:AMD64|amd64|x86_64|X86_64)$"
        }
      }
    },
    "nvidia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driverVersion",
        "driverSupportedCudaVersion",
        "gpuCount",
        "gpus"
      ],
      "properties": {
        "driverVersion": {
          "type": "string",
          "minLength": 1
        },
        "driverSupportedCudaVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "gpuCount": {
          "type": "integer",
          "minimum": 1
        },
        "gpus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "name",
              "uuid",
              "driverVersion",
              "memoryMiB"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "uuid": {
                "type": "string",
                "minLength": 1
              },
              "driverVersion": {
                "type": "string",
                "minLength": 1
              },
              "memoryMiB": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "windowsCudaRuntimePackQualified"
      ],
      "properties": {
        "status": {
          "const": "observation-only"
        },
        "windowsCudaRuntimePackQualified": {
          "const": false
        }
      }
    }
  }
}
