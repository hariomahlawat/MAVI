{
  "MediaStorage": {},
  "MediaProcessing": {
    "FfprobePath": "ffprobe",
    "FfmpegPath": "ffmpeg",
    "ProbeTimeoutSeconds": 30
  },
  "VideoImport": {
    "MaximumFileSizeBytes": 10737418240,
    "MultipartOverheadBytes": 1048576,
    "AllowedExtensions": [
      ".mp4"
    ]
  },
  "Localization": {
    "DefaultDisplayTimeZoneId": "Asia/Kolkata"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "VisionProcessing": {
    "Pipeline": "phase1-detection-tracking",
    "PipelineVersion": "phase1-v1",
    "MaximumAttempts": 3,
    "LeaseSeconds": 120,
    "HeartbeatExtensionSeconds": 120
  }
}
