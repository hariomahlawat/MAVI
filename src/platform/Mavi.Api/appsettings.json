{
  "MediaStorage": {},
  "MediaProcessing": {
    "FfprobePath": "ffprobe",
    "FfmpegPath": "ffmpeg",
    "BundledRootPath": "tools/ffmpeg",
    "BundledManifestPath": "tools/ffmpeg/manifest.json",
    "VerifyOnStartup": true,
    "AllowPathFallbackInDevelopment": false,
    "ProbeTimeoutSeconds": 30
  },
  "VideoImport": {
    "MaximumFileSizeBytes": 3221225472,
    "MultipartOverheadBytes": 1048576,
    "AllowedExtensions": [
      ".mp4"
    ]
  },
  "Localization": {
    "DefaultDisplayTimeZoneId": "Asia/Kolkata"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SceneAnalytics": {
    "Enabled": true,
    "ReconcileIntervalSeconds": 5,
    "LeaseSeconds": 900,
    "MaxUnitDurationSeconds": 300,
    "ReclaimGraceSeconds": 60,
    "MaximumAttempts": 3,
    "MaxConcurrentUnits": 1,
    "ReconcileBatchSize": 50,
    "ReconcileLookbackDays": 7
  },
  "VisionProcessing": {
    "Pipeline": "phase1-detection-tracking",
    "PipelineVersion": "phase1-v1",
    "MaximumAttempts": 3,
    "LeaseSeconds": 120,
    "HeartbeatExtensionSeconds": 120
  },
  "DatabaseMigrations": {
    "Enabled": true,
    "LockTimeoutSeconds": 120,
    "CommandTimeoutSeconds": 300
  },
  "DatabasePrerequisites": {
    "RequiredPostgreSqlMajorVersion": 18,
    "RequirePgVector": true
  },
  "VisionFinalization": {
    "Enabled": false
  },
  "StagingJanitor": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "GraceMinutes": 5,
    "UnknownJobGraceHours": 24,
    "MaxDirectoriesPerCycle": 1000,
    "WarnOldestEligibleMinutes": 60,
    "ErrorOldestEligibleMinutes": 360
  }
}
