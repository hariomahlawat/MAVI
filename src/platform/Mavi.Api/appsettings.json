{
  "MediaStorage": {},
  "MediaProcessing": {
    "FfprobePath": "ffprobe",
    "FfmpegPath": "ffmpeg",
    "BundledRootPath": "tools/ffmpeg",
    "BundledManifestPath": "tools/ffmpeg/manifest.json",
    "VerifyOnStartup": true,
    "RequireBundledTools": true,
    "AllowPathFallbackInDevelopment": false,
    "ProbeTimeoutSeconds": 30
  },
  "VideoImport": {
    "MaximumFileSizeBytes": 3221225472,
    "MultipartOverheadBytes": 1048576,
    "AllowedExtensions": [
      ".mp4"
    ]
  },
  "Localization": {
    "DefaultDisplayTimeZoneId": "Asia/Kolkata"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "VisionProcessing": {
    "Pipeline": "phase1-detection-tracking",
    "PipelineVersion": "phase1-v1",
    "MaximumAttempts": 3,
    "LeaseSeconds": 120,
    "HeartbeatExtensionSeconds": 120
  },
  "DatabaseMigrations": {
    "Enabled": true,
    "LockTimeoutSeconds": 120,
    "CommandTimeoutSeconds": 300
  },
  "DatabasePrerequisites": {
    "RequiredPostgreSqlMajorVersion": 18,
    "RequirePgVector": true
  }
}
