<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mavi.Api</RootNamespace>
    <AssemblyName>Mavi.Api</AssemblyName>
    <MaviBuild Condition="'$(MaviBuild)' == ''">unknown-development</MaviBuild>
    <MaviCommit Condition="'$(MaviCommit)' == ''">unknown-development</MaviCommit>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="MaviBuild" Value="$(MaviBuild)" />
    <AssemblyMetadata Include="MaviCommit" Value="$(MaviCommit)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mavi.Application\Mavi.Application.csproj" />
    <ProjectReference Include="..\Mavi.Infrastructure\Mavi.Infrastructure.csproj" />
    <ProjectReference Include="..\Mavi.Contracts\Mavi.Contracts.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <MaviFrontendDirectory>$(MSBuildProjectDirectory)/../../web/mavi-web</MaviFrontendDirectory>
    <SpaRoot>$(MaviFrontendDirectory)</SpaRoot>
    <SpaProxyServerUrl>http://127.0.0.1:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <MaviNativeMediaToolsDirectory>$(MSBuildProjectDirectory)/../../../vendor/ffmpeg</MaviNativeMediaToolsDirectory>
    <RequireMaviBundledMediaTools Condition="'$(RequireMaviBundledMediaTools)' == ''">false</RequireMaviBundledMediaTools>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MaviNativeMediaToolsDirectory)/manifest.json')">
    <Content Include="$(MaviNativeMediaToolsDirectory)/**/*">
      <Link>tools/ffmpeg/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="VerifyBundledMediaToolsForPublish"
          BeforeTargets="ComputeFilesToPublish"
          Condition="'$(RequireMaviBundledMediaTools)' == 'true'">
    <Error Condition="!Exists('$(MaviNativeMediaToolsDirectory)/manifest.json')"
           Text="MAVI production publish requires vendor/ffmpeg/manifest.json and its vetted native binaries. Stage the approved offline FFmpeg dependency pack before publishing." />
  </Target>

  <Target Name="BuildTask15Frontend" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(MaviFrontendDirectory)" Command="npm ci" />
    <Exec WorkingDirectory="$(MaviFrontendDirectory)" Command="npm run build" />
    <ItemGroup>
      <_MaviFrontendFiles Include="$(MaviFrontendDirectory)/dist/**/*" />
      <ResolvedFileToPublish Include="@(_MaviFrontendFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
