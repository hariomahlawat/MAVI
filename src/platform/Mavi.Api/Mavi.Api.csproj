<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mavi.Api</RootNamespace>
    <AssemblyName>Mavi.Api</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mavi.Application\Mavi.Application.csproj" />
    <ProjectReference Include="..\Mavi.Infrastructure\Mavi.Infrastructure.csproj" />
    <ProjectReference Include="..\Mavi.Contracts\Mavi.Contracts.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <MaviFrontendDirectory>$(MSBuildProjectDirectory)/../../web/mavi-web</MaviFrontendDirectory>
  </PropertyGroup>

  <Target Name="BuildTask15Frontend" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(MaviFrontendDirectory)" Command="npm ci" />
    <Exec WorkingDirectory="$(MaviFrontendDirectory)" Command="npm run build" />
    <ItemGroup>
      <_MaviFrontendFiles Include="$(MaviFrontendDirectory)/dist/**/*" />
      <ResolvedFileToPublish Include="@(_MaviFrontendFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
