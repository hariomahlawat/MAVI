{
  "schemaVersion": "mavi-plate-reading-order-v1",
  "rule": "Readings of a plate are ranked by confidence, descending; equal confidences are ordered by raw text in ascending UTF-16 code-unit order (.NET string.CompareOrdinal; Python: the UTF-16BE bytes). The order is strict: two readings with equal confidence and equal raw text are refused (plate_reading_invalid). A plate whose readings include such a duplicate has no rank order: the worker abstains that crop (ocr_output_invalid) and the platform refuses the sequence; vectors with \"refused\": true and \"rankedIndices\": null pin that.",
  "vectors": [
    {
      "name": "confidence decides first",
      "readings": [
        {
          "rawText": "KA01AB1234",
          "confidence": 0.6
        },
        {
          "rawText": "KA01AB1284",
          "confidence": 0.8
        }
      ],
      "rankedIndices": [
        1,
        0
      ],
      "refused": false
    },
    {
      "name": "ascii tie by code unit",
      "readings": [
        {
          "rawText": "KA01AB1Z34",
          "confidence": 0.8
        },
        {
          "rawText": "KA01AB1234",
          "confidence": 0.8
        }
      ],
      "rankedIndices": [
        1,
        0
      ],
      "refused": false
    },
    {
      "name": "a prefix ranks first",
      "readings": [
        {
          "rawText": "ABC",
          "confidence": 0.7
        },
        {
          "rawText": "AB",
          "confidence": 0.7
        }
      ],
      "rankedIndices": [
        1,
        0
      ],
      "refused": false
    },
    {
      "name": "supplementary-plane tie: UTF-16 order, not code-point order",
      "readings": [
        {
          "rawText": "\uff21",
          "confidence": 0.9
        },
        {
          "rawText": "\ud83d\ude00",
          "confidence": 0.9
        }
      ],
      "rankedIndices": [
        1,
        0
      ],
      "refused": false
    },
    {
      "name": "private-use vs supplementary tie: surrogates sort below U+E000",
      "readings": [
        {
          "rawText": "\ue000X",
          "confidence": 0.5
        },
        {
          "rawText": "\ud800\udc00X",
          "confidence": 0.5
        }
      ],
      "rankedIndices": [
        1,
        0
      ],
      "refused": false
    },
    {
      "name": "mixed: confidence, then code units",
      "readings": [
        {
          "rawText": "\uff21",
          "confidence": 0.9
        },
        {
          "rawText": "\ud83d\ude00",
          "confidence": 0.9
        },
        {
          "rawText": "ZZ",
          "confidence": 0.95
        },
        {
          "rawText": "A",
          "confidence": 0.4
        }
      ],
      "rankedIndices": [
        2,
        1,
        0,
        3
      ],
      "refused": false
    },
    {
      "name": "duplicate reading: equal confidence and raw text has no strict order",
      "readings": [
        {
          "rawText": "KA01AB1234",
          "confidence": 0.9
        },
        {
          "rawText": "KA01AB1234",
          "confidence": 0.9
        }
      ],
      "rankedIndices": null,
      "refused": true
    },
    {
      "name": "duplicate behind a distinct best reading is still refused",
      "readings": [
        {
          "rawText": "KA01AB1234",
          "confidence": 0.95
        },
        {
          "rawText": "\ud83d\ude00",
          "confidence": 0.6
        },
        {
          "rawText": "\ud83d\ude00",
          "confidence": 0.6
        }
      ],
      "rankedIndices": null,
      "refused": true
    }
  ]
}
