{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/contracts/vehicle-subclass-measurement-v1.schema.json",
  "title": "vehicle-subclass-measurement-v1",
  "description": "The Track-conditional vehicle subclass measurement (S3.2 plan T2): descriptive point estimates as exact fractions (value null when undefined), with no thresholds and no confidence intervals. primary aggregates the pilot and valid same-design continuations; each of those batches is also reported alone; supplemental batches are reported only under supplemental[] and never change primary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "labelVocabulary",
    "subclassVocabulary",
    "producer",
    "inputs",
    "primary",
    "batches",
    "supplemental"
  ],
  "properties": {
    "schemaVersion": {
      "const": "vehicle-subclass-measurement-v1"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "labelVocabulary": {
      "const": "mavi-vehicle-subclass-labels-v1"
    },
    "subclassVocabulary": {
      "const": "mavi-vehicle-subclass-v1"
    },
    "producer": {
      "type": "object",
      "required": [
        "modelId",
        "pipelineProfileSha256",
        "maviCommit",
        "subclassSource",
        "processingRunIds"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measuredProfileSha256",
        "requirementsSha256",
        "exportSha256s",
        "sourceVideoSha256s",
        "batches"
      ],
      "properties": {
        "measuredProfileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "requirementsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "exportSha256s": {
          "$ref": "#/$defs/sha256List"
        },
        "sourceVideoSha256s": {
          "$ref": "#/$defs/sha256List"
        },
        "batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sampleSha256",
              "designKind",
              "labelingGuideSha256",
              "primaryPackSha256",
              "primaryLabelsSha256",
              "overlapPackSha256",
              "overlapLabelsSha256",
              "adjudicationSha256"
            ],
            "properties": {
              "sampleSha256": {
                "$ref": "#/$defs/sha256"
              },
              "designKind": {
                "enum": [
                  "continuation",
                  "supplemental"
                ]
              },
              "labelingGuideSha256": {
                "$ref": "#/$defs/sha256"
              },
              "primaryPackSha256": {
                "$ref": "#/$defs/sha256"
              },
              "primaryLabelsSha256": {
                "$ref": "#/$defs/sha256"
              },
              "overlapPackSha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/sha256"
                  }
                ]
              },
              "overlapLabelsSha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/sha256"
                  }
                ]
              },
              "adjudicationSha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/sha256"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "primary": {
      "$ref": "#/$defs/section"
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/batch"
      }
    },
    "supplemental": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/batch"
      }
    }
