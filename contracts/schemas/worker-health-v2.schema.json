{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "worker-health-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workerId",
    "status",
    "timestampUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?=.{1,128}$)\\S(?:.*\\S)?$"
    },
    "status": {
      "const": "ready"
    },
    "timestampUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
