{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "face-lease-v1",
  "description": "The face analysis lease response (mavi-face-control-v1; ADR-022 section 3). The lease capability travels only in the X-Mavi-Lease-Capability response header and is never a member of this body. The Person Tracks of one completed ProcessingRun of a camera with face analysis enabled are leased, each with its accepted evidence crops in rank order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "processingRunId",
    "workerId",
    "attemptCount",
    "leaseExpiresAtUtc",
    "deadlineAtUtc",
    "identity",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mavi-face-control-v1"
    },
    "analysisId": {
      "$ref": "#/$defs/uuid"
    },
    "processingRunId": {
      "$ref": "#/$defs/uuid"
    },
    "workerId": {
      "$ref": "#/$defs/workerId"
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 1
    },
    "leaseExpiresAtUtc": {
      "$ref": "#/$defs/utc"
    },
    "deadlineAtUtc": {
      "$ref": "#/$defs/utc"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "tracks": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trackId",
          "objectClass",
          "observations"
        ],
        "properties": {
          "trackId": {
            "$ref": "#/$defs/uuid"
          },
          "objectClass": {
            "const": "Person"
          },
          "observations": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observationId",
                "role",
                "evidenceRank",
                "sizeBytes",
                "sha256"
              ],
              "properties": {
                "observationId": {
                  "$ref": "#/$defs/uuid"
                },
                "role": {
                  "$ref": "#/$defs/token"
                },
                "evidenceRank": {
                  "type": "integer",
                  "minimum": 0
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16777216
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "token": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9]))*$"
    },
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "vector": {
      "description": "Little-endian IEEE-754 float32 components, standard base64 with padding; finite, L2 norm 1 within 1e-3, exactly identity.model.dimension components (512 for AdaFace IR-50: 2732 characters; 128 for SFace).",
      "type": "string",
      "minLength": 4,
      "maxLength": 21848,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "schemaVersion",
        "model",
        "pipeline"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "schemaVersion": {
          "const": "mavi-face-identity-v1"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "manifestSha256",
            "dimension"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "manifestSha256": {
              "$ref": "#/$defs/sha256"
            },
            "dimension": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/token"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "coordinate": {
      "type": "number",
      "minimum": -100000,
      "maximum": 100000
    },
    "box": {
      "description": "The detected face box in source pixels of its image (evidence crop or query image), clipped to the image; 3 decimals.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "landmarks": {
      "description": "Five landmarks in source pixels: the subject's right eye, left eye, nose tip, right and left mouth corner (YuNet order); they may fall outside the clipped box.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "$ref": "#/$defs/coordinate"
        }
      }
    }
  }
}
