{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "face-query-lease-v1",
  "description": "The transient query-image lease response (mavi-face-control-v1; ADR-022 sections 4-5). The worker reads the image bytes from GET /api/faces/queries/{queryId}/image with the capability header and verifies their size and SHA-256 before decoding. The capability travels only in X-Mavi-Lease-Capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "queryId",
    "workerId",
    "attemptCount",
    "leaseExpiresAtUtc",
    "identity",
    "image"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mavi-face-control-v1"
    },
    "queryId": {
      "$ref": "#/$defs/uuid"
    },
    "workerId": {
      "$ref": "#/$defs/workerId"
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 1
    },
    "leaseExpiresAtUtc": {
      "$ref": "#/$defs/utc"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mimeType",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "mimeType": {
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "token": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9]))*$"
    },
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "schemaVersion",
        "model",
        "pipeline"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "schemaVersion": {
          "const": "mavi-face-identity-v1"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "manifestSha256",
            "dimension"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "manifestSha256": {
              "$ref": "#/$defs/sha256"
            },
            "dimension": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/token"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
