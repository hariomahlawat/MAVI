{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vision-job-lease-request-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workerId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    }
  }
}
