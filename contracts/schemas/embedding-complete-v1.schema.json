{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "embedding-complete-v1",
  "description": "The embedding analysis completion request (mavi-embedding-control-v1; ADR-021 section 3). Every leased Track appears exactly once, in lease order: 'embedded' with its L2-normalised mean vector over the crops whose shorter side is at least the profile's minimumCropSide, or 'unavailable' with a reason. The completion digest is the SHA-256 of the exact request body; an identical replay is idempotent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "workerId",
    "attemptCount",
    "provenance",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mavi-embedding-control-v1"
    },
    "analysisId": {
      "$ref": "#/$defs/uuid"
    },
    "workerId": {
      "$ref": "#/$defs/workerId"
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "identityFingerprint",
        "runtimeProfileId",
        "runtimeVariant",
        "executionProvider",
        "actualDevice",
        "deviceResolutionReason",
        "onnxRuntimeVersion",
        "workerVersion"
      ],
      "properties": {
        "roleId": {
          "const": "embeddings"
        },
        "identityFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "runtimeProfileId": {
          "$ref": "#/$defs/token"
        },
        "runtimeVariant": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "executionProvider": {
          "enum": [
            "CPUExecutionProvider",
            "CUDAExecutionProvider"
          ]
        },
        "actualDevice": {
          "type": "string",
          "pattern": "^(cpu|cuda:[0-9]{1,2})$"
        },
        "deviceResolutionReason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "onnxRuntimeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "workerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "tracks": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trackId",
              "outcome",
              "sourceObservationIds",
              "embedding"
            ],
            "properties": {
              "trackId": {
                "$ref": "#/$defs/uuid"
              },
              "outcome": {
                "const": "embedded"
              },
              "sourceObservationIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/uuid"
                }
              },
              "embedding": {
                "$ref": "#/$defs/vector"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trackId",
              "outcome",
              "reason"
            ],
            "properties": {
              "trackId": {
                "$ref": "#/$defs/uuid"
              },
              "outcome": {
                "const": "unavailable"
              },
              "reason": {
                "enum": [
                  "no_evidence",
                  "evidence_too_small",
                  "evidence_unavailable"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "token": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9]))*$"
    },
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "vector": {
      "description": "Little-endian IEEE-754 float32 components, standard base64 with padding; finite, L2 norm 1 within 1e-3, exactly identity.model.dimension components (768 for the SigLIP 2 pack: 4096 characters).",
      "type": "string",
      "minLength": 4,
      "maxLength": 21848,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "schemaVersion",
        "model",
        "pipeline"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "schemaVersion": {
          "const": "mavi-embedding-identity-v1"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "manifestSha256",
            "dimension"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "manifestSha256": {
              "$ref": "#/$defs/sha256"
            },
            "dimension": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/token"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
