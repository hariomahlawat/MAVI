{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plate-predictions-v1",
  "description": "The sealed PlatePredictions artefact (mavi-plate-predictions-v1; ADR-013 implementation amendment 2026-10-13, items 12-15). Canonical UTF-8 JSON: sorted keys, compact separators, ASCII only (non-ASCII escaped), no NaN, one trailing LF; the platform hashes the received bytes and never re-serialises. Every leased crop appears exactly once, in lease order; every detector proposal (at most two) carries its score; every OCR reading (at most three) of the one accepted plate is kept with its rank. Output beyond the bounded profile is a contract violation, never truncated. Track texts name their best plate; their text is that plate's normalised rank-0 reading. Cross-member rules are enforced by the platform validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysisId", "identityFingerprint", "normalisation", "parametersSha256", "pipeline", "schemaVersion", "summaryPolicy", "tracks"],
  "properties": {
    "analysisId": { "$ref": "#/$defs/uuid" },
    "identityFingerprint": { "$ref": "#/$defs/sha256" },
    "normalisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": { "id": { "const": "mavi-plate-normalisation-v1" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "parametersSha256": { "$ref": "#/$defs/sha256" },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "$ref": "#/$defs/token" }, "version": { "$ref": "#/$defs/version" } }
    },
    "schemaVersion": { "const": "mavi-plate-predictions-v1" },
    "summaryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "version"],
      "properties": { "id": { "$ref": "#/$defs/token" }, "sha256": { "$ref": "#/$defs/sha256" }, "version": { "$ref": "#/$defs/version" } }
    },
    "tracks": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/track" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "token": { "type": "string", "maxLength": 64, "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9]))*$" },
    "version": { "type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crops", "outcome", "reason", "texts", "trackId"],
      "properties": {
        "crops": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/crop" } },
        "outcome": { "enum": ["analysed", "unavailable"] },
        "reason": {
          "enum": [null, "evidence_integrity_failed", "evidence_missing", "evidence_decode_failed", "plate_inference_failed", "no_accepted_evidence"]
        },
        "texts": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/text" } },
        "trackId": { "$ref": "#/$defs/uuid" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "analysed" } } },
          "then": { "properties": { "reason": { "const": null } } },
          "else": { "properties": { "reason": { "type": "string" }, "texts": { "maxItems": 0 } } }
        }
      ]
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cropHeight", "cropWidth", "detections", "evidenceRank", "observationId", "reason", "role", "status"],
      "properties": {
        "cropHeight": { "type": ["integer", "null"], "minimum": 1, "maximum": 4096 },
        "cropWidth": { "type": ["integer", "null"], "minimum": 1, "maximum": 4096 },
        "detections": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/detection" } },
        "evidenceRank": { "type": "integer", "minimum": 0, "maximum": 3 },
        "observationId": { "$ref": "#/$defs/uuid" },
        "reason": {
          "enum": [null, "decode_failed", "detector_error", "ocr_error", "ocr_output_invalid", "evidence_missing", "evidence_integrity_failed"]
        },
        "role": { "enum": ["representative", "near-view", "early-diverse", "late-diverse"] },
        "status": { "enum": ["scored", "abstained", "excluded", "unavailable"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "scored" } } },
          "then": { "properties": { "reason": { "const": null }, "cropWidth": { "type": "integer" }, "cropHeight": { "type": "integer" } } }
        },
        {
          "if": { "properties": { "status": { "const": "abstained" } } },
          "then": { "properties": { "reason": { "enum": ["decode_failed", "detector_error", "ocr_error", "ocr_output_invalid"] } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["excluded", "unavailable"] } } },
          "then": {
            "properties": {
              "cropWidth": { "const": null },
              "cropHeight": { "const": null },
              "detections": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "excluded" } } },
          "then": { "properties": { "reason": { "const": null } } }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": { "properties": { "reason": { "enum": ["evidence_missing", "evidence_integrity_failed"] } } }
        }
      ]
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["box", "plate", "score"],
      "properties": {
        "box": {
          "description": "[x, y, width, height] in the decoded crop's pixel space.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "type": "integer", "minimum": 0, "maximum": 4095 },
            { "type": "integer", "minimum": 0, "maximum": 4095 },
            { "type": "integer", "minimum": 1, "maximum": 4096 },
            { "type": "integer", "minimum": 1, "maximum": 4096 }
          ],
          "items": false
        },
        "plate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/plate" }] },
        "score": { "$ref": "#/$defs/confidence" }
      }
    },
    "plate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "plateIndex", "readings"],
      "properties": {
        "outcome": { "enum": ["read", "unreadable"] },
        "plateIndex": { "type": "integer", "minimum": 0, "maximum": 0 },
        "readings": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/reading" } }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "rank", "rawLineCount", "rawText"],
      "properties": {
        "confidence": { "$ref": "#/$defs/confidence" },
        "rank": { "type": "integer", "minimum": 0, "maximum": 2 },
        "rawLineCount": { "enum": [1, 2] },
        "rawText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(\\n[^\\u0000-\\u001f\\u007f]+)?$"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bestPlate", "maxConfidence", "supportCount"],
      "properties": {
        "bestPlate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observationId", "plateIndex"],
          "properties": { "observationId": { "$ref": "#/$defs/uuid" }, "plateIndex": { "type": "integer", "minimum": 0, "maximum": 0 } }
        },
        "maxConfidence": { "$ref": "#/$defs/confidence" },
        "supportCount": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    }
  }
}
