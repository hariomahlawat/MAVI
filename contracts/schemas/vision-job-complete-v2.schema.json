{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vision-job-complete-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "workerId",
    "leaseToken",
    "attemptCount",
    "framesProcessed",
    "processingDurationMs",
    "provenance",
    "tracks"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "jobId": { "type": "string", "format": "uuid" },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "leaseToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "attemptCount": { "type": "integer", "minimum": 1 },
    "framesProcessed": { "type": "integer", "minimum": 0 },
    "processingDurationMs": { "type": "integer", "minimum": 0 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageKey", "mediaType", "sizeBytes", "sha256"],
      "properties": {
        "storageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*:).+(?<!/)$"
        },
        "mediaType": { "type": "string", "enum": ["image/jpeg", "application/msgpack"] },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "representative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offsetMs", "sourceFrameNumber", "confidence", "qualityScore", "boundingBox", "thumbnail"],
      "properties": {
        "offsetMs": { "type": "integer", "minimum": 0 },
        "sourceFrameNumber": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "boundingBox": { "$ref": "#/$defs/boundingBox" },
        "thumbnail": { "$ref": "#/$defs/artifact" }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackId",
        "objectClass",
        "startOffsetMs",
        "endOffsetMs",
        "detectionCount",
        "meanConfidence",
        "maxConfidence",
        "representative",
        "trajectoryArtifact"
      ],
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "objectClass": { "type": "string", "enum": ["person", "vehicle"] },
        "startOffsetMs": { "type": "integer", "minimum": 0 },
        "endOffsetMs": { "type": "integer", "minimum": 0 },
        "detectionCount": { "type": "integer", "minimum": 1 },
        "meanConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "representative": { "$ref": "#/$defs/representative" },
        "trajectoryArtifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "release", "version", "machine", "processor", "pythonVersion", "pythonImplementation", "pythonBuild", "pythonCompiler"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "machine": { "type": "string", "minLength": 1 },
        "processor": { "type": "string", "minLength": 1 },
        "pythonVersion": { "type": "string", "minLength": 1 },
        "pythonImplementation": { "type": "string", "minLength": 1 },
        "pythonBuild": {
          "type": "array",
          "prefixItems": [{ "type": "string", "minLength": 1 }, { "type": "string", "minLength": 1 }],
          "minItems": 2,
          "maxItems": 2
        },
        "pythonCompiler": { "type": "string", "minLength": 1 }
      }
    },
    "gpu": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "index", "vramBytes", "driverVersion", "cudaRuntimeVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "vramBytes": { "type": "integer", "minimum": 1 },
        "driverVersion": { "type": "string", "minLength": 1 },
        "cudaRuntimeVersion": { "type": "string", "minLength": 1 }
      }
    },
    "trackerParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceFrameRate", "trackActivationThreshold", "highConfidenceThreshold", "minimumIouThreshold", "minimumConsecutiveFrames", "lostTrackBufferSeconds"],
      "properties": {
        "referenceFrameRate": { "type": "number", "exclusiveMinimum": 0 },
        "trackActivationThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "highConfidenceThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumIouThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumConsecutiveFrames": { "type": "integer", "minimum": 1 },
        "lostTrackBufferSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "modelVersion",
        "modelManifestSha256",
        "checkpointSha256",
        "resolvedConfigSha256",
        "pipelineProfileId",
        "pipelineProfileVersion",
        "pipelineProfileSha256",
        "verificationStatus",
        "runtimeProfileId",
        "runtimeProfileSha256",
        "runtimeVariant",
        "detectorBackend",
        "dependencyVersions",
        "platform",
        "configuredDevicePolicy",
        "configuredDeviceIndex",
        "actualDevice",
        "maviBuild",
        "maviCommit",
        "framePolicy",
        "trackerParameters",
        "inputColourSpace"
      ],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "modelManifestSha256": { "$ref": "#/$defs/sha256" },
        "checkpointSha256": { "$ref": "#/$defs/sha256" },
        "resolvedConfigSha256": { "$ref": "#/$defs/sha256" },
        "pipelineProfileId": { "type": "string", "minLength": 1 },
        "pipelineProfileVersion": { "type": "string", "minLength": 1 },
        "pipelineProfileSha256": { "$ref": "#/$defs/sha256" },
        "qualificationId": { "type": ["string", "null"], "minLength": 1 },
        "qualificationSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "verificationStatus": { "type": "string", "enum": ["verified", "unverified"] },
        "runtimeProfileId": { "type": "string", "minLength": 1 },
        "runtimeProfileSha256": { "$ref": "#/$defs/sha256" },
        "runtimeVariant": { "type": "string", "minLength": 1 },
        "platformLockSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "detectorBackend": { "type": "string", "minLength": 1 },
        "dependencyVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "ffmpegVersion": { "type": ["string", "null"], "minLength": 1 },
        "platform": { "$ref": "#/$defs/platform" },
        "configuredDevicePolicy": { "type": "string", "enum": ["cpu", "cuda", "auto"] },
        "configuredDeviceIndex": { "type": "integer", "minimum": 0 },
        "actualDevice": { "type": "string", "minLength": 1 },
        "gpu": { "$ref": "#/$defs/gpu" },
        "maviBuild": { "type": "string", "minLength": 1 },
        "maviCommit": { "type": "string", "minLength": 1 },
        "framePolicy": { "const": "every-frame" },
        "trackerParameters": { "$ref": "#/$defs/trackerParameters" },
        "inputColourSpace": { "const": "RGB" }
      }
    }
  }
}
