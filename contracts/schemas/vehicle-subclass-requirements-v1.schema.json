          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum"
          ],
          "properties": {
            "minimum": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "perClass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "car",
            "truck",
            "bus",
            "motorcycle"
          ],
          "properties": {
            "car": {
              "type": "object",
