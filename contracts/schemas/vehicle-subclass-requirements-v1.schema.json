                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "minimumSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
