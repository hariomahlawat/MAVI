                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ]
                    }
                  }
                },
                "recall": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "minimum"
                  ],
                  "properties": {
                    "minimum": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ]
                    }
                  }
                }
              }
