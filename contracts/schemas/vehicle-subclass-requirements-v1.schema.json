{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/contracts/vehicle-subclass-requirements-v1.schema.json",
  "title": "vehicle-subclass-requirements-v1",
  "description": "The pre-registered bar for the S3.2 measurement (plan section 13): an operational requirement whose values may each be null (no defensible requirement yet), a separate minimum evidence support, and the insufficient-support outcome. Committed before any Track is labelled and bound by hash and commit into every sample. Criteria apply to descriptive point estimates of the primary aggregate only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "labelVocabulary",
    "operational",
    "minimumSupport",
    "insufficientSupportOutcome"
  ],
  "properties": {
    "schemaVersion": {
      "const": "vehicle-subclass-requirements-v1"
    },
    "labelVocabulary": {
      "const": "mavi-vehicle-subclass-labels-v1"
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverageOverEvaluable",
        "perClass"
      ],
      "properties": {
