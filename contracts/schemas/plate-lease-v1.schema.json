{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plate-lease-v1",
  "description": "The plate analysis lease response (mavi-plate-control-v1; ADR-013 implementation amendment 2026-10-13, item 11). The lease capability travels only in the X-Mavi-Lease-Capability response header and is never a member of this body. Only Vehicle Tracks are leased.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "processingRunId", "workerId", "attemptCount", "leaseExpiresAtUtc", "deadlineAtUtc", "identity", "tracks"],
  "properties": {
    "schemaVersion": { "const": "mavi-plate-control-v1" },
    "analysisId": { "$ref": "#/$defs/uuid" },
    "processingRunId": { "$ref": "#/$defs/uuid" },
    "workerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "attemptCount": { "type": "integer", "minimum": 1 },
    "leaseExpiresAtUtc": { "$ref": "#/$defs/utc" },
    "deadlineAtUtc": { "$ref": "#/$defs/utc" },
    "identity": { "$ref": "#/$defs/identity" },
    "tracks": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$" },
    "token": { "type": "string", "maxLength": 64, "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9]))*$" },
    "version": { "type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modelPackId": { "type": "string", "pattern": "^mavi-model-v2-[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "pipelineId", "pipelineVersion", "predictionsSchemaVersion", "normalisation", "summaryPolicy", "capabilities", "parametersSha256"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "pipelineId": { "$ref": "#/$defs/token" },
        "pipelineVersion": { "$ref": "#/$defs/version" },
        "predictionsSchemaVersion": { "const": "mavi-plate-predictions-v1" },
        "normalisation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": { "const": "mavi-plate-normalisation-v1" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "summaryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "sha256"],
          "properties": {
            "id": { "$ref": "#/$defs/token" },
            "version": { "$ref": "#/$defs/version" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "capabilities": {
          "description": "Exactly ocr then plate-detector (ordinal order).",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "modelPackId"],
              "properties": { "capabilityId": { "const": "ocr" }, "modelPackId": { "$ref": "#/$defs/modelPackId" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "modelPackId"],
              "properties": { "capabilityId": { "const": "plate-detector" }, "modelPackId": { "$ref": "#/$defs/modelPackId" } }
            }
          ],
          "items": false
        },
        "parametersSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackId", "objectClass", "observations"],
      "properties": {
        "trackId": { "$ref": "#/$defs/uuid" },
        "objectClass": { "const": "vehicle" },
        "observations": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "role", "evidenceRank", "sizeBytes", "sha256"],
      "properties": {
        "observationId": { "$ref": "#/$defs/uuid" },
        "role": { "enum": ["representative", "near-view", "early-diverse", "late-diverse"] },
        "evidenceRank": { "type": "integer", "minimum": 0, "maximum": 3 },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 163840 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
