  "$id": "https://mavi.local/contracts/vehicle-subclass-labeling-pack-v1.schema.json",
  "title": "vehicle-subclass-labeling-pack-v1",
  "description": "The manifest (pack-manifest.json) of one reviewer's blind labelling pack (S3.2 plan T4). packSha256 is the SHA-256 of these canonical bytes and is never stored here; files[] lists every pack file except this manifest and the derived pack-data.js. The run/Track mapping lives only here; no prediction, confidence or producer detail appears in the pack.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "seed",
        "sampleSha256",
        "exportSha256s",
        "pipelineProfileSha256",
        "evidenceSelectorVersion",
        "evidenceScorerVersion",
        "labelingGuide",
        "extraction",
        "items",
        "files",
        "viewKind"
      ],
      "properties": {
        "schemaVersion": {
          "const": "vehicle-subclass-labeling-pack-v1"
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
        },
        "sampleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exportSha256s": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "pipelineProfileSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidenceSelectorVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
        },
        "evidenceScorerVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
        },
        "labelingGuide": {
          "type": "object",
          "additionalProperties": false,
