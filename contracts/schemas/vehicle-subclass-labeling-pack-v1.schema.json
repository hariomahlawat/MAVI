            "gitCommit",
            "gitPath",
            "path"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "gitCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "gitPath": {
              "const": "docs/qualification/stage3/s3-2-labeling-guide.md"
            },
            "path": {
              "const": "labeling-guide.md"
