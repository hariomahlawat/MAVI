        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decoder",
            "renderer",
            "renderRuleVersion",
            "maxLongEdgePx"
          ],
          "properties": {
            "decoder": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "av",
                "libavcodec"
              ],
              "properties": {
                "av": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(.*\\S)?$"
                },
                "libavcodec": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(.*\\S)?$"
                }
              }
            },
            "renderer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pillow"
              ],
              "properties": {
                "pillow": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(.*\\S)?$"
                }
              }
            },
            "renderRuleVersion": {
              "const": "context-v1"
            },
            "maxLongEdgePx": {
              "const": 1280
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "processingRunId",
              "trackId",
              "videoSourceSha256",
              "views"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "processingRunId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "trackId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "videoSourceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "views": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "evidenceRole",
                    "sourceFrameNumber",
                    "videoOffsetMs",
                    "path",
                    "sha256",
                    "sizeBytes"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "crop",
                        "context"
                      ]
                    },
                    "evidenceRole": {
                      "enum": [
                        "Representative",
                        "NearView",
                        "EarlyDiverse",
                        "LateDiverse"
                      ]
                    },
                    "sourceFrameNumber": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "videoOffsetMs": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^items/[0-9a-f]{16}/[a-z0-9-]+\\.(jpg|png)$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "sizeBytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "sizeBytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "viewKind": {
          "const": "primary"
        }
      }
    },
