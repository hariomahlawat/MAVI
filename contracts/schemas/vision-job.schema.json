{
  "$id": "urn:mavi:schema:vision-job:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "processingRunId", "videoAssetId", "cameraId", "pipeline", "pipelineVersion", "sourceStorageKey", "sourceSha256", "sourceSizeBytes", "recordingStartUtc", "recordingEndUtc", "durationMs", "width", "height", "frameRateNumerator", "frameRateDenominator", "attemptCount", "leaseExpiresAtUtc", "recordingTimeZoneId", "recordingUtcOffsetMinutes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "format": "uuid" },
    "processingRunId": { "type": "string", "format": "uuid" },
    "videoAssetId": { "type": "string", "format": "uuid" },
    "cameraId": { "type": "string", "format": "uuid" },
    "pipeline": { "type": "string", "minLength": 1 },
    "pipelineVersion": { "type": "string", "minLength": 1 },
    "sourceStorageKey": { "type": "string", "pattern": "^[^\\\\:]+$" },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceSizeBytes": { "type": "integer", "minimum": 0 },
    "recordingStartUtc": { "type": "string", "format": "date-time" },
    "recordingEndUtc": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "frameRateNumerator": { "type": "integer", "minimum": 1 },
    "frameRateDenominator": { "type": "integer", "minimum": 1 },
    "attemptCount": { "type": "integer", "minimum": 1 },
    "leaseExpiresAtUtc": { "type": "string", "format": "date-time" },
    "recordingTimeZoneId": { "type": "string", "minLength": 1 },
    "recordingUtcOffsetMinutes": { "type": "integer", "minimum": -840, "maximum": 840 }
  }
}
