{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vision-job-finalization-response-v3.1",
  "description": "Completion 3.1 acknowledgement (S1.4 B3 asynchronous finalization plan section 5.2): a durable hand-off, never a completion claim. completedAtUtc is present only with state 'completed'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "processingRunId",
    "state",
    "acceptedAtUtc",
    "tracksSubmitted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.1"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "processingRunId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "finalizing",
        "completed"
      ]
    },
    "acceptedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "tracksSubmitted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "completedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "completedAtUtc"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "finalizing"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "completedAtUtc"
          ]
        }
      }
    }
  ]
}
