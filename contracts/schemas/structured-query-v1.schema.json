{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "structured-query-v1",
  "description": "One structured query of contract mavi-query-v1 (ADR-024). Closed: every object refuses unknown members and every enumeration is fixed. The platform's strict parser is the runtime authority; contracts/test-vectors/structured-query-v1-golden.json holds both to the same corpus. Rules this schema cannot state (fromUtc before toUtc, bucket count, plate-text normalisation, one value per attribute type, the bound attribute vocabulary, references that must exist) are the parser's or the service's, and the corpus marks each such case.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "unit", "where", "operation"],
  "properties": {
    "contractVersion": { "const": "mavi-query-v1" },
    "unit": { "enum": ["track", "event", "entity"] },
    "where": { "$ref": "#/$defs/where" },
    "operation": { "$ref": "#/$defs/operation" },
    "requireCompleteCoverage": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "required": ["unit"], "properties": { "unit": { "const": "track" } } },
      "then": {
        "properties": {
          "where": {
            "propertyNames": {
              "enum": ["timeWindow", "cameraIds", "objectClass", "objectSubclass", "minDurationMs", "minConfidence", "zone", "line", "motion", "attributes", "plateText", "similarTo"]
            }
          },
          "operation": { "$ref": "#/$defs/trackDimensions" }
        }
      }
    },
    {
      "if": { "required": ["unit"], "properties": { "unit": { "const": "event" } } },
      "then": {
        "properties": {
          "where": {
            "propertyNames": { "enum": ["timeWindow", "cameraIds", "objectClass", "zone", "line", "ruleIds", "catalogueVersion"] },
            "properties": { "zone": { "propertyNames": { "const": "zoneId" } } }
          },
          "operation": { "$ref": "#/$defs/eventDimensions" }
        }
      }
    },
    {
      "if": { "required": ["unit"], "properties": { "unit": { "const": "entity" } } },
      "then": {
        "properties": {
          "where": { "propertyNames": { "enum": ["timeWindow", "cameraIds"] } },
          "operation": { "$ref": "#/$defs/entityDimensions" }
        }
      }
    },
    {
      "$comment": "A zone, line or motion predicate on the Track unit belongs to one camera's scene revision.",
      "if": {
        "required": ["unit", "where"],
        "properties": {
          "unit": { "const": "track" },
          "where": { "anyOf": [{ "required": ["zone"] }, { "required": ["line"] }, { "required": ["motion"] }] }
        }
      },
      "then": {
        "properties": { "where": { "required": ["cameraIds"], "properties": { "cameraIds": { "maxItems": 1 } } } }
      }
    },
    {
      "$comment": "similarTo is a ranking: find only, with timeWindow, at most one camera and objectClass.",
      "if": { "required": ["where"], "properties": { "where": { "required": ["similarTo"] } } },
      "then": {
        "properties": {
          "where": {
            "propertyNames": { "enum": ["timeWindow", "cameraIds", "objectClass", "similarTo"] },
            "properties": { "cameraIds": { "maxItems": 1 } }
          },
          "operation": {
            "properties": { "op": { "const": "find" }, "order": { "const": "newest" } }
          }
        }
      }
    },
    {
      "$comment": "As on Track search, attributes and a plate text are never combined.",
      "not": { "required": ["where"], "properties": { "where": { "required": ["attributes", "plateText"] } } }
    },
    {
      "$comment": "A plate or subclass predicate implies Vehicle.",
      "if": {
        "required": ["where"],
        "properties": { "where": { "anyOf": [{ "required": ["plateText"] }, { "required": ["objectSubclass"] }] } }
      },
      "then": { "properties": { "where": { "properties": { "objectClass": { "const": "Vehicle" } } } } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|\\+00:00)$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromUtc", "toUtc"],
      "properties": {
        "fromUtc": { "$ref": "#/$defs/instant" },
        "toUtc": { "$ref": "#/$defs/instant" }
      }
    },
    "token": { "type": "string", "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9]))*$", "maxLength": 64 },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeWindow"],
      "properties": {
        "timeWindow": { "$ref": "#/$defs/window" },
        "cameraIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "objectClass": { "enum": ["Person", "Vehicle"] },
        "objectSubclass": { "enum": ["car"] },
        "minDurationMs": { "type": "integer", "minimum": 0 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "zone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zoneId"],
          "properties": {
            "zoneId": { "$ref": "#/$defs/uuid" },
            "relation": { "enum": ["entered", "exited", "dwelled"] },
            "minDwellMs": { "type": "integer", "minimum": 0 },
            "loitering": { "type": "boolean" }
          }
        },
        "line": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineId"],
          "properties": {
            "lineId": { "$ref": "#/$defs/uuid" },
            "direction": { "enum": ["aToB", "bToA"] }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "direction": { "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"] },
            "minStationaryMs": { "type": "integer", "minimum": 0 }
          }
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": { "type": { "$ref": "#/$defs/token" }, "value": { "$ref": "#/$defs/token" } }
          }
        },
        "plateText": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 64 },
            "match": { "enum": ["contains", "prefix", "exact"] }
          }
        },
        "similarTo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trackId"],
          "properties": {
            "trackId": { "$ref": "#/$defs/uuid" },
            "k": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["line-crossing", "zone-dwell", "stopped-vehicle", "wrong-way", "co-occurrence", "repeated-visit"] }
        },
        "catalogueVersion": { "const": "mavi-events-v1" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["op"],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "op": { "const": "find" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
            "order": { "enum": ["newest", "oldest"] }
          }
        },
        {
          "additionalProperties": false,
          "properties": { "op": { "enum": ["count", "first", "last"] } }
        },
        {
          "additionalProperties": false,
          "required": ["field"],
          "properties": { "op": { "const": "countDistinct" }, "field": { "type": "string" } }
        },
        {
          "additionalProperties": false,
          "required": ["by"],
          "properties": { "op": { "const": "groupBy" }, "by": { "type": "string" } }
        },
        {
          "additionalProperties": false,
          "required": ["by"],
          "properties": {
            "op": { "const": "top" },
            "by": { "type": "string" },
            "k": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["bucketSeconds"],
          "properties": {
            "op": { "const": "timeBucket" },
            "bucketSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["baseline"],
          "properties": { "op": { "const": "compare" }, "baseline": { "$ref": "#/$defs/window" } }
        }
      ]
    },
    "trackDimensions": {
      "properties": {
        "field": { "enum": ["camera", "objectClass", "video"] },
        "by": { "enum": ["camera", "objectClass", "objectSubclass"] }
      }
    },
    "eventDimensions": {
      "properties": {
        "field": { "enum": ["camera", "track", "rule"] },
        "by": { "enum": ["camera", "rule", "objectClass", "direction", "zone", "line"] }
      }
    },
    "entityDimensions": {
      "properties": {
        "field": { "const": "camera" },
        "by": { "const": "camera" }
      }
    }
  }
}
