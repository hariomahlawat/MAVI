{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vision-job-fail-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workerId",
    "leaseToken",
    "failureCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "leaseToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "failureCode": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])",
      "minLength": 1
    },
    "failureMessage": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    }
  }
}
