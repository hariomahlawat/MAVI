{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vision-job-fail-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workerId",
    "leaseToken",
    "failureCode",
    "failureMessage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "leaseToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "failureCode": {
      "type": "string",
      "maxLength": 64
    },
    "failureMessage": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
