{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/contracts/vehicle-subclass-adjudication-v1.schema.json",
  "title": "vehicle-subclass-adjudication-v1",
  "description": "The prediction-blind resolution of the overlap (S3.2 plan T5): both reviewers' original decisions kept attributable, and the final truth per overlap Track, carried when both agree (same label, or unknown with the same reason) and otherwise decided by the adjudicator. adjudicatedOn is a declared fact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "primaryLabelsSha256",
    "overlapLabelsSha256",
    "adjudicator",
    "adjudicatedOn",
    "vocabulary",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "vehicle-subclass-adjudication-v1"
    },
    "primaryLabelsSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "overlapLabelsSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adjudicator": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "adjudicatedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "vocabulary": {
      "const": "mavi-vehicle-subclass-labels-v1"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "processingRunId",
              "trackId",
              "primary",
              "overlap",
              "resolution",
              "adjudicatedLabel"
            ],
            "properties": {
              "processingRunId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "trackId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "primary": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "enum": [
                          "car",
                          "truck",
                          "bus",
                          "motorcycle"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "unknownReason"
                    ],
                    "properties": {
                      "label": {
                        "const": "unknown"
                      },
                      "unknownReason": {
                        "enum": [
                          "occluded",
                          "too-small",
                          "ambiguous-type",
                          "mixed-track",
                          "not-a-vehicle",
                          "other"
                        ]
                      }
                    }
                  }
                ]
              },
              "overlap": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "enum": [
                          "car",
                          "truck",
                          "bus",
                          "motorcycle"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "unknownReason"
                    ],
                    "properties": {
                      "label": {
                        "const": "unknown"
                      },
                      "unknownReason": {
                        "enum": [
                          "occluded",
                          "too-small",
                          "ambiguous-type",
                          "mixed-track",
                          "not-a-vehicle",
                          "other"
                        ]
                      }
                    }
                  }
                ]
              },
              "resolution": {
                "enum": [
                  "carried",
                  "adjudicated"
                ]
              },
              "adjudicatedLabel": {
                "enum": [
                  "car",
                  "truck",
                  "bus",
                  "motorcycle"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "processingRunId",
              "trackId",
              "primary",
              "overlap",
              "resolution",
              "adjudicatedLabel",
              "adjudicatedUnknownReason"
            ],
            "properties": {
              "processingRunId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "trackId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "primary": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "enum": [
                          "car",
                          "truck",
                          "bus",
                          "motorcycle"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "unknownReason"
                    ],
                    "properties": {
                      "label": {
                        "const": "unknown"
                      },
                      "unknownReason": {
                        "enum": [
                          "occluded",
                          "too-small",
                          "ambiguous-type",
                          "mixed-track",
                          "not-a-vehicle",
                          "other"
                        ]
                      }
                    }
                  }
                ]
              },
              "overlap": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "enum": [
                          "car",
                          "truck",
                          "bus",
                          "motorcycle"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "unknownReason"
                    ],
                    "properties": {
                      "label": {
                        "const": "unknown"
                      },
                      "unknownReason": {
                        "enum": [
                          "occluded",
                          "too-small",
                          "ambiguous-type",
                          "mixed-track",
                          "not-a-vehicle",
                          "other"
                        ]
                      }
                    }
                  }
                ]
              },
              "resolution": {
                "enum": [
                  "carried",
                  "adjudicated"
                ]
              },
              "adjudicatedLabel": {
                "const": "unknown"
              },
              "adjudicatedUnknownReason": {
                "enum": [
                  "occluded",
                  "too-small",
                  "ambiguous-type",
                  "mixed-track",
                  "not-a-vehicle",
                  "other"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
