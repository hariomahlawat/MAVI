{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavi.local/schemas/phase1-corpus-manifest-v1.json",
  "title": "MAVI Phase-1 Qualification Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "cases"],
  "properties": {
    "schemaVersion": { "const": "mavi-phase1-corpus-v1" },
    "corpusId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "mediaSha256", "groundTruthManifestSha256"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "mediaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "groundTruthManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
